	},
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"@types/node": "^20.19.0",
		"jest": "^29.7.0",
		"nengi": "2.0.0-rc.125",
		"ts-jest": "^29.4.0",
		"typescript": "^5.9.3"
	},
	"dependencies": {
